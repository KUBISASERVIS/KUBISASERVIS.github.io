  <meta name="keywords" content="servis kursi pijat jakarta, servis kursi pijat panggilan, teknisi kursi pijat jakarta">

  <style>
    * { box-sizing: border-box; font-family: Arial, sans-serif; }

    body {
      margin: 0;
      background: linear-gradient(135deg, #eef6ff, #fefefe);
      color: #333;
      overflow-x: hidden;
    }

    /* Decorative accent */
    .accent {
      position: absolute;
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, #4bcffa, #0fbcf9);
      opacity: 0.18;
      border-radius: 50%;
      top: -140px;
      right: -140px;
      z-index: 0;
    }

    header {
      position: relative;
      padding: 80px 20px;
      text-align: center;
      background: linear-gradient(135deg, #0fbcf9, #4bcffa);
      color: white;
      z-index: 1;
    }

    header h1 {
      font-size: 34px;
      margin-bottom: 12px;
    }

    header p {
      max-width: 720px;
      margin: auto;
      font-size: 16px;
      line-height: 1.6;
    }

    .btn {
      display: inline-block;
      margin-top: 28px;
      padding: 14px 28px;
      background: #25D366;
      color: white;
      text-decoration: none;
      border-radius: 30px;
      font-weight: bold;
      box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    section {
      max-width: 1100px;
      margin: auto;
      padding: 60px 20px;
    }

    h2 {
      text-align: center;
      font-size: 26px;
      margin-bottom: 35px;
    }

    /* Grid & card */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 22px;
    }

    .card {
      background: white;
      padding: 26px;
      border-radius: 18px;
      box-shadow: 0 10px 28px rgba(0,0,0,0.12);
      text-align: center;
    }

    /* Gallery */
    .gallery img {
      width: 100%;
      border-radius: 16px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.22);
    }

    ul {
      text-align: left;
      padding-left: 20px;
      line-height: 1.9;
    }

    .contact {
      text-align: center;
    }

    .maps a {
      color: #0b6efd;
      font-weight: bold;
      text-decoration: none;
    }

    footer {
      background: #1e272e;
      color: white;
      text-align: center;
      padding: 25px;
      font-size: 14px;
    }

    /* Floating WhatsApp */
    .wa-float {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #25D366;
      color: white;
      padding: 14px 18px;
      border-radius: 50px;
      font-weight: bold;
      text-decoration: none;
      box-shadow: 0 8px 22px rgba(0,0,0,0.35);
      z-index: 99;
    }
  </style>
</head>

<body>

<div class="accent"></div>

